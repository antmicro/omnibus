`verilator_config 
//outports are assigned near destination rather than near source
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*output*src*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*output*dst*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_src*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_dst*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_main*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_sb_cpu*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_sb_lpp*"

//pulp flops use resets asynchronously and their assertions use them synchronously, newer Verilator reports it
lint_off -rule SYNCASYNCNET -file "*build/src/*.sv*"

//unlikely to cause problems
lint_off -rule SPLITVAR -file "*" -contents "*" -match "*bitwidth is 1*"
lint_off -rule GENUNNAMED

//not good but should not cause problems, at least for tests
lint_off -rule IMPORTSTAR

//some signals are not used by the bridge
lint_off -rule UNUSEDSIGNAL -file "out/src/axi_prconv_axi_ahb.sv"
