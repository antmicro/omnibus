`verilator_config 
//topwrap generates file without EoF NewLine
lint_off -rule EOFNEWLINE -file "*build/*.sv*"

//outports are assigned near destination rather than near source
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*output*src*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*output*dst*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_src*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_dst*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*o_main*"

//I do not know what to do with these
//lint off so they dont pollute the output
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*free_clk*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*scan_mode*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*bus_clk*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*clk_override*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*force_halt*"
lint_off -rule PINMISSING -file "*build/*.sv*" -contents "*" -match "*rst_l*"

//some signals are not used by the bridge
lint_off -rule UNUSEDSIGNAL -file "out/src/axi_prconv_axi_ahb.sv"

//unlikely to cause problems
lint_off -rule SPLITVAR -file "*" -contents "*" -match "*bitwidth is 1*"
lint_off -rule GENUNNAMED

//rvdff is located in beh_lib
lint_off -rule DECLFILENAME -file "out/src/beh_lib.sv"

//not good but should not cause problems, at least for tests
lint_off -rule IMPORTSTAR

//user warning about deprecated package, irrelevant
//for whatever reason, this does not work
//the file is modified in place instead
lint_off -rule USERWARN -file "*common_cells/src/deprecated/cf_math_pkg.sv*" -contents "*" -match "*deprecated*"

//likely only simulation problem
//requires further care to be sure though
lint_off -rule UNOPTFLAT -file "*common_cells/*"
lint_off -rule UNOPTFLAT -file "*axi/*"
//taken from VeeR
lint_off -rule UNOPTFLAT -file "*axi_prconv_axi_ahb.sv*"
