digraph butterflyish {
	node [colorscheme=paired12 style=filled]
	rankdir=LR
	splines=line
	i0 [fillcolor=1]
	i0 -> x0_i0
	i1 [fillcolor=1]
	i1 -> x0_i1
	i2 [fillcolor=1]
	i2 -> x1_i0
	i3 [fillcolor=1]
	i3 -> x1_i1
	o0 [fillcolor=4]
	o1 [fillcolor=4]
	o2 [fillcolor=3]
	o3 [fillcolor=2]
	x0_o0 -> iw_conv_x0_o0_2
	x0_o1 -> x2_i0
	x1_o0 -> x2_i1
	x1_o1 -> o3
	x2_o0 -> x3_i1
	x2_o1 -> o2
	x3_o0 -> o0
	x3_o1 -> o1
	iw_conv_x3_i0_3 -> x3_i0
	subgraph "cluster legend" {
		label="legend - id_width"
		color=lightgrey
		rank=same
		1 [fillcolor=1]
		1 -> 2 [style=invis]
		2 [fillcolor=2]
		2 -> 3 [style=invis]
		3 [fillcolor=3]
		3 -> 4 [style=invis]
		4 [fillcolor=4]
		4 -> none [style=invis]
		none [fillcolor=white]
	}
	subgraph "cluster x0" {
		label="crossbar
x0"
		color=lightgrey style=dashed
		x0_i0 [fillcolor=1]
		x0_i0 -> x0_o0
		x0_i0 -> x0_o1
		x0_i1 [fillcolor=1]
		x0_i1 -> x0_o0
		x0_i1 -> x0_o1
		x0_o0 [fillcolor=2]
		x0_o1 [fillcolor=2]
	}
	subgraph "cluster x1" {
		label="crossbar
x1"
		color=lightgrey style=dashed
		x1_i0 [fillcolor=1]
		x1_i0 -> x1_o0
		x1_i0 -> x1_o1
		x1_i1 [fillcolor=1]
		x1_i1 -> x1_o0
		x1_i1 -> x1_o1
		x1_o0 [fillcolor=2]
		x1_o1 [fillcolor=2]
	}
	subgraph "cluster x2" {
		label="crossbar
x2"
		color=lightgrey style=dashed
		x2_i0 [fillcolor=2]
		x2_i0 -> x2_o0
		x2_i0 -> x2_o1
		x2_i1 [fillcolor=2]
		x2_i1 -> x2_o0
		x2_i1 -> x2_o1
		x2_o0 [fillcolor=3]
		x2_o1 [fillcolor=3]
	}
	subgraph "cluster x3" {
		label="crossbar
x3"
		color=lightgrey style=dashed
		x3_i0 [fillcolor=3]
		x3_i0 -> x3_o0
		x3_i0 -> x3_o1
		x3_i1 [fillcolor=3]
		x3_i1 -> x3_o0
		x3_i1 -> x3_o1
		x3_o0 [fillcolor=4]
		x3_o1 [fillcolor=4]
	}
	subgraph "cluster iw_conv_x0_o0_2_to_x3_i0_3" {
		label=iw_conv
		color=lightgrey style=dashed
		iw_conv_x0_o0_2 [label=2 fillcolor=2]
		iw_conv_x0_o0_2 -> iw_conv_x3_i0_3
		iw_conv_x3_i0_3 [label=3 fillcolor=3]
	}
}
